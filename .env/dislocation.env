# Pricing Dislocation — Coco Hands-On Lab
# Deployment configuration.
#
# Usage:
#   # edit the values below (at minimum CLI_CONNECTION_NAME), then:
#   ./setup.sh
#
# This file is the single source of truth for setup.sh. Every variable below
# is required (those with a default may be left as-is). setup.sh exports these
# and they override the defaults in sql/snowflake.yml when snowclisp runs the
# numbered SQL files via `snow sql`.

# Snowflake CLI connection name (from ~/.snowflake/connections.toml).
#
#   • CLI / Coco Desktop: set this to your own connection name (key-pair auth
#     recommended). This is the only thing you configure in advance.
#   • Snowsight (Cloud Agents): leave it as `default`. The Cloud Agents sandbox
#     provides a pre-wired `snow` connection named `default` bound to your
#     ambient Snowsight session — no connections.toml setup required.
CLI_CONNECTION_NAME=default

# Role used to run the install. Needs CREATE DATABASE / WAREHOUSE / ROLE and
# (to create the agent) the ability to CREATE AGENT + cross-region inference.
ROLE=ACCOUNTADMIN

# Warehouse created and used for the lab.
WAREHOUSE=DISLOCATION_DEMO_WH

# Target database for all lab objects.
DATABASE=DISLOCATION_DEMO

# Core schema: tables, views, semantic views, agent, roles.
SCHEMA=CORE

# Skills schema: hosts the named stage that stores the agent's SKILL.md files.
SKILLS_SCHEMA=SKILLS

# Named stage (inside SKILLS_SCHEMA) the 5 Cortex Agent skills are uploaded to.
STAGE=SKILL_STAGE
